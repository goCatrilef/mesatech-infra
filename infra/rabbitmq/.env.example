# Copia como ".env" en la EC2 C. El ".env" real NO se sube al repositorio.
# Evita comillas, espacios, barras invertidas y el caracter " en las claves (el script usa JSON simple).

# Administrador de RabbitMQ (solo para operar el broker; las apps NO lo usan)
RABBITMQ_ADMIN_USER=mesatech_admin
RABBITMQ_ADMIN_PASSWORD=cambiar-por-clave-real

# Usuarios de las aplicaciones (los crea setup-rabbitmq.sh)
RABBITMQ_PUBLISHER_USER=mesatech_publicador
RABBITMQ_PUBLISHER_PASSWORD=cambiar-por-clave-real
RABBITMQ_CONSUMER_USER=mesatech_consumidor
RABBITMQ_CONSUMER_PASSWORD=cambiar-por-clave-real
